# 监听地址
HOST=0.0.0.0
PORT=8787

# 通过 Nginx / Caddy 反向代理时设为 1，用 X-Forwarded-For 识别客户端 IP
TRUST_PROXY=0

# 允许的 WebSocket Origin（逗号分隔）。桌面客户端默认 Origin 为 null，通常留空。
ALLOWED_ORIGINS=

# STUN（逗号分隔）。局域网可以留空；公网建议至少一个。
STUN_URLS=stun:stun.l.google.com:19302

# TURN（逗号分隔）。公网跨 NAT 时强烈建议配置。
# coturn 需要开启 use-auth-secret，并设置 static-auth-secret。
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600

# 每 IP / 每远控码每分钟允许的配对尝试次数
MAX_ATTEMPTS_PER_MINUTE=10

# 客户端列表、邀请码、审计日志的持久化目录（默认 ./data）
DATA_DIR=./data

# 对外展示的地址，例如 https://remote.example.com；缺省时由客户端自行填写
PUBLIC_URL=
SERVER_NAME=若道远程服务

# 接入模式：invite（邀请码）/ approval（管理员审核）/ open（开放接入）
REGISTRATION_MODE=invite

# ---------- 远控风控（可在管理后台实时修改） ----------
# 最大同时远控人数，0 表示不限制；达到上限后新用户会收到“服务器已满”提示
MAX_SESSIONS=0
# 单次远控时长上限（分钟），0 表示不限制；到时自动结束会话
SESSION_LIMIT_MINUTES=0
# 达到单次时长上限后，控制方需要等待的冷却时间（分钟）
COOLDOWN_MINUTES=5
# 管理员点击“冻结”时的默认时长（分钟）
FREEZE_MINUTES=10

# 管理后台登录态有效期（小时）
ADMIN_SESSION_HOURS=12

# 管理员密码：任选其一。留空则 /admin 与客户端管理功能不可用。
# ADMIN_PASSWORD=请替换为强密码
# ADMIN_PASSWORD_HASH=scrypt$...

# 管理后台路径（6-64 位字母、数字、点、下划线或连字符）。留空使用 /admin。
# 对外部署建议使用随机路径，降低被扫描器发现的概率；一键部署会自动生成。
# ADMIN_PATH=/manage-a1b2c3d4

# 健康检查令牌。设置后 /health 与 /api/version 需携带 x-ruodao-health 头或 ?token=。
# 一键部署会自动生成并保存在客户端加密设置中。
# HEALTH_TOKEN=至少32位随机字符串

# 安全事件日志（JSON Lines），可交给 fail2ban 读取；默认 DATA_DIR/security.log
# SECURITY_LOG_FILE=/var/lib/ruodao/security.log

# ---------- 连接与请求限流 ----------
# 每 IP 并发 WebSocket 连接数上限
MAX_CONNECTIONS_PER_IP=8
# 服务端总并发 WebSocket 连接数上限
MAX_TOTAL_CONNECTIONS=400
# 每 IP 每 10 秒允许的 WebSocket 消息数
MESSAGE_LIMIT_PER_10S=120
# 每 IP 每分钟允许的 HTTP 请求数
HTTP_REQUESTS_PER_MINUTE=600
# WebSocket 心跳间隔（秒）
HEARTBEAT_SECONDS=30
# 服务端带宽/CPU/延迟采样间隔（秒）
SERVER_STATS_SECONDS=5

# ---------- 服务端更新 ----------
# 从若道发布接口检查新版本；设为 0 可完全关闭（本机服务端默认关闭）。
UPDATE_ENABLED=1
# 更新源，默认 https://ruodao.com；测试时可指向本地服务
# UPDATE_BASE_URL=https://ruodao.com
# 发布清单路径，默认 /api/desktop/releases
# UPDATE_MANIFEST_PATH=/api/desktop/releases
UPDATE_CHANNEL=stable
# 要替换的服务端单文件与 systemd 服务名（SSH 一键部署的默认布局）
UPDATE_ENTRY_FILE=/opt/ruodao/server.cjs
UPDATE_SERVICE_NAME=ruodao-remote
# 下载暂存目录，默认 DATA_DIR/updates
# UPDATE_STAGE_DIR=/var/lib/ruodao/updates
# 自动检查间隔（小时）
UPDATE_CHECK_HOURS=6
# 是否自动应用更新（需同时配置 UPDATE_APPLY_COMMAND，且当前没有进行中的会话）
UPDATE_AUTO_APPLY=0
# 系统级自动更新：由 root 权限的 ruodao-remote-update.timer 定时执行
# `server.cjs --self-update`，无需给服务进程提权。一键部署会自动安装该定时器。
# UPDATE_SYSTEM_UPDATER=1
# 有远控会话时暂缓自动安装，空闲后再更新（默认开启，设为 0 可强制立即安装）
# UPDATE_REQUIRE_IDLE=1
# 具备安装权限的更新助手命令。留空时只下载并校验，由管理员手动执行页面给出的命令。
# 助手会通过环境变量收到 RUODAO_UPDATE_FILE / RUODAO_UPDATE_SHA256 / RUODAO_UPDATE_VERSION
# UPDATE_APPLY_COMMAND=sudo -n /usr/local/bin/ruodao-remote-apply-update
# 额外允许的下载域名（逗号分隔，默认只允许 ruodao.com 及其子域名）
# UPDATE_ALLOWED_HOSTS=cdn.example.com
